# Robinhood Chain mainnet deploy settings, read by deploy-mainnet.sh and
# handover.sh. Public values only: the keys live in ~/.config/recurve
# (deployer.key, agent.key + agent.address), never in this repository.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The fund asset. USDG makes a dollar fund (6 decimals); WETH is
# 0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73. Both were rehearsed on a fork.
VAULT_ASSET=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Whole units of VAULT_ASSET. Only the deployer key can raise it later
# (vault.raiseDepositCap), and nobody can lower it.
DEPOSIT_CAP=10000

# The Safe (multisig) on Robinhood Chain that receives the performance fee and,
# after handover.sh, owns the registry, the agent list and the $RECURVE supply.
TREASURY=

# $RECURVE is launched on Pons v2 (the owner's plan): launch it there FIRST and
# put its address here; the deploy then creates no token of its own and
# handover.sh leaves it alone. Empty would mint a separate 1B token to the
# deployer. The watcher registry fixes this address forever. A Pons v2 token
# was staked and unstaked through WatcherRegistry on a fork (2026-11-03):
# plain ERC-20, no transfer tax, amounts exact.
REVE_TOKEN=

# The strategy's basket: NVDA through the 0.05% WETH/USDG pools (deepest on
# 2026-10-31; see DEPLOY-MAINNET.md).
DEX_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2
NVDA_TOKEN=0xd0601CE157Db5bdC3162BbaC2a2C8aF5320D9EEC
FEE_TIER=500
